pipeline {
    agent any

    tools {
        maven 'maven'
    }

    environment {
        AWS_ACCOUNT_ID = "435392106236"
        AWS_REGION     = "ap-south-1"
        REPO_NAME      = "devops"
        ECR_REGISTRY   = "435392106236.dkr.ecr.ap-south-1.amazonaws.com"
        REGISTRY_URL   = "435392106236.dkr.ecr.ap-south-1.amazonaws.com/devops"
        IMAGE_TAG      = "${env.BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Mitali-05/Attendance_Management_System.git'
                script {
                    env.GIT_COMMIT_SHORT = bat(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim().readLines().last()
                    echo "Commit: ${env.GIT_COMMIT_SHORT}"
                }
            }
        }

        stage('Test') {
            steps {
                bat 'mvn test'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Build JAR') {
            steps {
                bat 'mvn clean package -DskipTests'
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    bat "docker build -t %REPO_NAME%:%IMAGE_TAG% ."
                    echo "Built: ${REPO_NAME}:${IMAGE_TAG}"
                }
            }
        }

        stage('Login to ECR') {
            steps {
                withCredentials([[
                    $class            : 'AmazonWebServicesCredentialsBinding',
                    credentialsId     : 'aws-credentials',
                    accessKeyVariable : 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable : 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    bat "aws ecr get-login-password --region %AWS_REGION% | docker login --username AWS --password-stdin %ECR_REGISTRY%"
                }
            }
        }

        stage('Push to ECR') {
            steps {
                script {
                    bat """
                        docker tag %REPO_NAME%:%IMAGE_TAG% %REGISTRY_URL%:%IMAGE_TAG%
                        docker tag %REPO_NAME%:%IMAGE_TAG% %REGISTRY_URL%:latest
                        docker push %REGISTRY_URL%:%IMAGE_TAG%
                        docker push %REGISTRY_URL%:latest
                    """
                    echo "Pushed: ${REGISTRY_URL}:${IMAGE_TAG}"
                }
            }
        }

        stage('Cleanup') {
            steps {
                script {
                    bat """
                        docker rmi %REPO_NAME%:%IMAGE_TAG%    || exit 0
                        docker rmi %REGISTRY_URL%:%IMAGE_TAG% || exit 0
                        docker rmi %REGISTRY_URL%:latest      || exit 0
                    """
                }
            }
        }
    }

    post {
        success {
            echo "========================================="
            echo "BUILD #${BUILD_NUMBER} SUCCEEDED"
            echo "Image: ${REGISTRY_URL}:${IMAGE_TAG}"
            echo "Commit: ${env.GIT_COMMIT_SHORT}"
            echo "========================================="
        }
        failure {
            echo "========================================="
            echo "BUILD #${BUILD_NUMBER} FAILED"
            echo "Check console output: ${BUILD_URL}console"
            echo "========================================="
        }
        always {
            cleanWs()
        }
    }
}